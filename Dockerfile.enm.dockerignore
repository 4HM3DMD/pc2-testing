# What NOT to send into the Docker build context.
# Keeps `docker build` fast and prevents host-only state from leaking into the
# image (think: a developer's local volatile/runtime database).

# VCS
.git
**/.git
.gitignore

# Node — node_modules gets freshly installed inside the image, but the
# lockfile MUST be in the build context so `npm ci` can read it (npm ci
# fails without a lockfile, and we need npm ci specifically to preserve
# the nested ajv@8 / ajv-keywords@5 structure that webpack relies on).
node_modules
**/node_modules
npm-debug.log
**/npm-debug.log

# PC2 runtime state — must NOT be baked into the image. The operator's data
# lives in the bind-mounted /data volume.
volatile

# Local environment overrides
.env
.env.local
.env.*.local

# Editor / OS noise
.DS_Store
Thumbs.db
.vscode
.idea

# Build output / coverage / caches that some sub-projects produce
**/coverage
**/.cache
**/dist
**/build

# Docker meta — no point copying these into the image being built.
Dockerfile
.dockerignore
docker-compose.yml
**/docker-compose.yml

# Tarballs from previous builds
*.tar.gz
