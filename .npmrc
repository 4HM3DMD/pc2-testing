engine-strict=true
# Workspace pins different jsdom majors across src/gui (jsdom 21) and
# src/backend (jsdom 27), which transitively want different canvas majors.
# canvas is an optional peer used only by jsdom test rendering — neither
# PC2 nor any extension uses it at runtime. npm 7+ refuses to resolve the
# diamond by default; flip back to the npm 6 behavior that picks per-
# workspace nested copies. Documented in extensions/elastos-node-manager/
# README.md "Installation" section.
legacy-peer-deps=true