PORT=4000

# ── Lit Protocol / Chipotle ─────────────────────────────────────────
# Lit Action CID used by /lit/secure-view. Pinned to IPFS after the
# first /api/storage/lit/deploy-action run. The same CID appears in
# the self-referential access-control condition at encrypt time.
#
# During the Phase 2d rollout of Option C (session-key delegation) we
# keep BOTH the legacy and the sigauth CIDs pinned. The server
# forwards whichever action source matches the client request:
#   - Clients that send { delegation, delegationSig, request, requestSig }
#     get `non-media-decrypt-chipotle-sigauth.js` at LIT_ACTION_CID.
#   - Legacy clients (no bundle) transparently fall back to
#     `non-media-decrypt-chipotle.js` at LIT_ACTION_CID_LEGACY.
# After 14 days of zero legacy requests LIT_ACTION_CID_LEGACY can be
# removed and the legacy file deleted from disk.
LIT_ACTION_CID=
LIT_ACTION_CID_LEGACY=

# Media CEK recovery action (DASH/CENC playback). Same rollout rules
# as the non-media pair above.
MEDIA_ACTION_CID=
MEDIA_ACTION_CID_LEGACY=

# Backend selector. Default "chipotle" uses the Chipotle REST API
# (PKP-AES). "datil" falls back to the legacy Datil SDK (threshold BLS,
# only needed to read pre-migration assets).
LIT_BACKEND=chipotle
