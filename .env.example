PORT=4000

# ── Lit Protocol / Chipotle ─────────────────────────────────────────
# Lit Action CID used by /lit/secure-view. Pinned to IPFS after the
# first /api/storage/lit/deploy-action run. The same CID appears in
# the self-referential access-control condition at encrypt time.
#
# IMPORTANT: on Chipotle the Lit Action source is shipped INLINE to
# /core/v1/lit_action (not fetched from IPFS), so this CID is used
# only to stamp `delegation.actionIpfsId` at /lit/begin-session and
# to verify `del.actionIpfsId === jsParams.actionIpfsId` inside the
# sigauth Lit Action. Pinning to IPFS is for provenance + audit.
#
# Phase 2d sigauth Lit Actions pinned 2026-04-20 via Pinata:
#   non-media-decrypt-chipotle-sigauth.js
#     → bafkreihvm4zkyuefnuptlbdins6cmd2mbslj2xgnyzz3ssdg2ggg3jtkk4
#   media-decrypt-chipotle-sigauth.js
#     → bafkreihw7brius3xw2u7ltjac26hoqudulkc6mfwqrjxtrobanz2ryhvsq
#
# Rollout: the legacy CID stays in place for 14 days so legacy
# clients that don't send a session bundle keep working. The server
# auto-selects legacy vs sigauth source per request based on bundle
# presence (see `getChipotleNonMediaActionCode` in chipotle-client.ts).
LIT_ACTION_CID=bafkreihvm4zkyuefnuptlbdins6cmd2mbslj2xgnyzz3ssdg2ggg3jtkk4
LIT_ACTION_CID_LEGACY=QmNayE5MYzXcoMS9nvRk6MUo8r4ESLa3i65vHXzuBsnC2b

# Media CEK recovery action (DASH/CENC playback). On V1.2 Chipotle
# the media path routes through recoverNonMediaCEK and therefore uses
# LIT_ACTION_CID. MEDIA_ACTION_CID is reserved for a future split if
# media verification logic ever diverges from non-media.
MEDIA_ACTION_CID=bafkreihw7brius3xw2u7ltjac26hoqudulkc6mfwqrjxtrobanz2ryhvsq
MEDIA_ACTION_CID_LEGACY=

# Backend selector. Default "chipotle" uses the Chipotle REST API
# (PKP-AES). "datil" falls back to the legacy Datil SDK (threshold BLS,
# only needed to read pre-migration assets).
LIT_BACKEND=chipotle
