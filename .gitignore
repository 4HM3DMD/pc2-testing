# Lit Protocol / Chipotle secrets (API keys, server keys, provision cache)
pc2-node/data/.chipotle-*
pc2-node/data/.lit-*

# Security test artefacts (exploit target config + evidence logs with redacted CEKs)
# These scripts prove the Lit Action vulnerability exists; they are NEVER run in CI.
scripts/security/exploit-target.json
scripts/security/.exploit-evidence/

# Phase 1 spike run artefacts (timestamped JSON per run). The scripts
# themselves are tracked; only the raw run outputs are gitignored.
scripts/spike/.results/

# Confidential handover docs (contain API keys) - only IRZHY handover has secrets
docs/handover/IRZHY_DDRM_HANDOVER.md

# Built app outputs (generated by build scripts)
pc2-node/data/test-apps/elastos-nft/

# Built assets in particle-auth
src/particle-auth/assets
# Local dev-only scratch assets (EPUB/CBZ test fixtures, 3D model samples,
