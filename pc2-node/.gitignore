# Dependencies
node_modules/

# Build output
dist/

# Bundled platform binaries (fetched via scripts/fetch-binaries.sh)
bin/

# Compiled TypeScript in src/ (source is .ts, compiled goes to dist/)
src/**/*.js
src/**/*.js.map
src/**/*.d.ts
src/**/*.d.ts.map

# Environment variables
.env
.env.local

# Logs
*.log
npm-debug.log*

# OS files
.DS_Store
Thumbs.db

# IDE
.vscode/
.idea/

# Data (user data, databases, runtime state — but NOT test-apps or lit-actions source)
data/*
!data/test-apps/
!data/lit-actions/
*.db
*.db-shm
*.db-wal
backups/*.tar.gz
.old-backup/
nohup.out
