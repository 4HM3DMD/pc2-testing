{
  "name": "elacity-creator",
  "title": "Elacity Creator",
  "version": "0.1.0",
  "description": "Encrypt, upload, and list any digital asset on the Elacity marketplace. Supports PDFs, images, audio, 3D models, AI models, datasets, and more.",
  "author": {
    "name": "Elacity Labs",
    "url": "https://ela.city"
  },
  "license": "proprietary",
  "icon": "icon.png",
  "entry": "index.html",
  "type": "web",
  "category": "creator",

  "capabilities": {
    "wallet": true,
    "network": true,
    "ipfs": { "pin": true, "fetch": true, "add": true },
    "ipc": ["launchApp", "openFolder"],
    "drm": true,
    "api_endpoints": [
      "POST /read",
      "POST /api/storage/ipfs/add-directory",
      "POST /api/storage/ipfs/add",
      "POST /api/storage/ipfs/upload-elacity",
      "POST /api/storage/ipfs/pin",
      "POST /api/storage/lit/encrypt",
      "POST /api/storage/thumbnail",
      "POST /api/media/encode",
      "GET /api/media/encode/status/:jobId",
      "POST /api/drafts",
      "GET /api/drafts/:id",
      "DELETE /api/drafts/:id"
    ],
    "postMessage_events": {
      "sends": ["mint-draft-saved", "mint-close-creator"],
      "receives": []
    },
    "external_services": [
      "https://base.ela.city/api/2.0/graphql",
      "https://mainnet.base.org",
      "https://ipfs.ela.city/ipfs/"
    ]
  },

  "requirements": {
    "minVersion": "1.1.0"
  },

  "display": {
    "maximize": true,
    "resizable": true,
    "titlebar": true,
    "taskbar": true
  },

  "services": [
    {
      "name": "creator",
      "protocol": "https",
      "description": "Elacity decentralized asset creation and listing"
    }
  ],

  "distribution": {
    "channel": "stable"
  }
}
