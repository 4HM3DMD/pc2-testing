{
  "name": "pc2-media-runtime",
  "title": "Elacity Player",
  "version": "0.1.0",
  "description": "Secure DASH/CENC media player for PC2 — plays DRM-protected video and audio inside PC2 using WASM decryption",
  "author": "Elacity",
  "icon": "data:image/svg+xml;base64,",
  "entry": "index.html",
  "type": "web",
  "category": "media",
  "role": "system",

  "capabilities": {
    "wallet": false,
    "network": true,
    "drm": true,
    "api_endpoints": [
      "POST /api/media/prepare-auth",
      "POST /api/media/init",
      "POST /api/media/segment"
    ],
    "postMessage_events": {
      "sends": [],
      "receives": []
    }
  },

  "requirements": {
    "minVersion": "1.1.0"
  },
  "metadata": {
    "window_size": { "width": "960", "height": "640" },
    "hide_titlebar": false
  },

  "hidden": true
}
