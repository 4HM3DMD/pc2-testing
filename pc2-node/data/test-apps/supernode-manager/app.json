{
  "name": "supernode-manager",
  "title": "Supernode Manager",
  "version": "1.0.0",
  "description": "Run and manage a full PC2 supernode from your node. Check system specs, deploy services, and monitor network health.",
  "author": {
    "name": "Elacity Labs",
    "url": "https://ela.city"
  },
  "license": "proprietary",
  "icon": "icon.svg",
  "iconDataUrl": "data:image/svg+xml;base64,",
  "entry": "index.html",
  "type": "web",

  "capabilities": {
    "network": true,
    "ipc": ["launchApp"],
    "api_endpoints": [
      "GET /api/supernode/specs",
      "GET /api/supernode/relay/status",
      "GET /api/boson/connectivity",
      "GET /api/registry/supernodes"
    ],
    "postMessage_events": {
      "sends": [],
      "receives": []
    }
  },

  "requirements": {
    "minVersion": "1.1.0"
  },

  "display": {
    "maximize": false,
    "resizable": true,
    "titlebar": true,
    "taskbar": true,
    "width": 800,
    "height": 650
  },

  "distribution": {
    "channel": "stable"
  },

  "category": "system",
  "system": true
}
